<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a">

    <!-- عنصر السحب لتحديث الصفحة والـ WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0f172a" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- شاشة البداية الأصلية لتطبيق وصلني (تغطي الـ WebView بالكامل لمنع ظهور شعار جوجل ستوديو) -->
    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0f172a"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <!-- أيقونة التطبيق -->
            <ImageView
                android:id="@+id/appLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="شعار وصلني بورسعيد"
                android:src="@drawable/ic_launcher_foreground" />

            <!-- اسم التطبيق -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="وصلني بورسعيد"
                android:textColor="#ffffff"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- وصف التطبيق -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="منظومة النقل الذكي ببورسعيد"
                android:textColor="#94a3b8"
                android:textSize="13sp" />

            <!-- مؤشر تحميل هادئ وأنيق -->
            <ProgressBar
                android:id="@+id/loadingProgress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="28dp"
                android:indeterminateTint="#10b981" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
